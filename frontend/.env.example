# Frontend environment (Vite)
# Restart `npm run dev` after changing these values.

# Leave empty to use the Vite HTTPS proxy (same origin) — recommended for webcam
# on LAN (https://YOUR-IP:8080). Or set a full backend URL, e.g. http://192.168.x.x:5000
VITE_API_URL=

# Socket.io — empty = same origin (proxied). Or set e.g. http://192.168.x.x:5000
VITE_SOCKET_URL=
