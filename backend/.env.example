NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/academy_management
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=12h
JWT_REFRESH_EXPIRES=30d
CLIENT_URL=http://192.168.88.41:8080
REDIS_URL=redis://127.0.0.1:6379
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
FIREBASE_SERVICE_ACCOUNT_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Default admin (created/ensured on every server start if missing)
SEED_ADMIN_EMAIL=admin@academy.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_PHONE=00000000000
# SEED_ADMIN_RESET_PASSWORD=true

# Face recognition worker (InsightFace) — NO separate database.
# All enrollments + attendance are stored in MongoDB (this app).
FACE_WORKER_URL=http://127.0.0.1:8090

# CCTV / gate camera — set your RTSP URL here (password @ must be %40)
# Example: rtsp://admin:Pak%4000721@192.168.88.22:554/Streaming/Channels/102
AI_CAMERA_RTSP_URL=
AI_CAMERA_NAME=Gate Camera
AI_CAMERA_LOCATION=Main entrance
# Optional: multiple cameras, comma-separated
# AI_CAMERA_RTSP_URLS=rtsp://...,rtsp://...
# AI_CAMERA_AUTOSTART=true
# AI_CAMERA_SCAN_MS=2000
# Minutes after first class period before student is marked late (default 0)
# AI_ATTENDANCE_LATE_GRACE_MINUTES=5
